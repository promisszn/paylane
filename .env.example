# --- PayPal (sandbox) ---
# developer.paypal.com > Apps & Credentials > your app (Sandbox toggle on)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional. Only needed if you register a webhook (see README > Webhooks).
PAYPAL_WEBHOOK_ID=

# --- AI model ---
# "google" (Gemini, default), "anthropic" or "openai". Fill in the matching key.
AI_PROVIDER=google
# Gemini key from aistudio.google.com/apikey (has a free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional override. Defaults: gemini-flash-lite-latest / claude-sonnet-5-5 / gpt-5-mini
AI_MODEL=

# --- You, the freelancer (shown on invoices) ---
FREELANCER_NAME=Alex Freelancer
FREELANCER_BUSINESS=Alex Studio
DEFAULT_CURRENCY=USD

# --- Demo mode (sandbox only) ---
# Adds a "Backdate" button to sent invoices so the reminder flow can be shown without waiting days.
DEMO_MODE=false
# Optional secret that enables POST /api/demo/reset (wipes projects and activity). Any long random string.
DEMO_RESET_TOKEN=
