# --- PayPal (sandbox) ---
# developer.paypal.com > Apps & Credentials > your app (Sandbox toggle on)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional. Only needed if you register a webhook (see README > Webhooks).
PAYPAL_WEBHOOK_ID=

# --- AI model ---
# "anthropic", "openai" or "google" (Gemini). Fill in the matching key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini key from aistudio.google.com (has a free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override. Defaults: claude-sonnet-5-5 / gpt-5-mini / gemini-flash-lite-latest
AI_MODEL=

# --- You, the freelancer (shown on invoices) ---
FREELANCER_NAME=Alex Freelancer
FREELANCER_BUSINESS=Alex Studio
DEFAULT_CURRENCY=USD

# --- Demo mode (sandbox only) ---
# Adds a "Backdate" button to sent invoices so the reminder flow can be shown without waiting days.
DEMO_MODE=false
